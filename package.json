{
  "name": "arc-raiders-recycle-tool",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://SquaredCub.github.io/arc-raiders-recycle-tool",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/generate-files-from-data.js",
    "dev": "bun x vite",
    "prebuild": "bun scripts/generate-files-from-data.js",
    "build": "bun x tsc && bun x vite build",
    "deploy": "bun scripts/deploy.js",
    "deploy:quick": "bun run build && bun x gh-pages -d dist --no-history",
    "generate": "bun scripts/generate-files-from-data.js",
    "test": "bun test src",
    "test:e2e": "bun x playwright test --project=chromium",
    "test:all": "bun test src && bun x playwright test --project=chromium"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.97.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}